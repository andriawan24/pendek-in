# Pendek CLI Environment Variables
# Copy this file to .env and adjust values as needed.

# API base URL (default: https://link.andriawan.dev)
PENDEK_API_URL=https://link.andriawan.dev

# Configuration directory (default: ~/.config/pendek-in)
# PENDEK_CONFIG_DIR=

# Output format: set to "true" for JSON output
# PENDEK_JSON=false

# Disable colored output
# NO_COLOR=1
